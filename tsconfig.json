{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "customConditions": ["react-native", "react-native-legacy-deep-imports"],
    "strict": true,
    "paths": {
      "@/*": ["./*"],
      "@types/*": ["./types/*"]
    }
  },
  "exclude": ["node_modules", "design-reference", ".ai-progress"],
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
